<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Follow-ups" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-white text-ink antialiased">
    <header class="bg-brand-600">
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4">
        <%= link_to root_path, class: "flex items-center gap-2 text-lg font-bold tracking-tight text-white" do %>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M4 20 L20 4 M4 4 L20 20"/>
          </svg>
          Follow-ups
        <% end %>
        <nav class="flex gap-1 text-sm">
          <%= nav_link_to "Triage", root_path %>
          <%= nav_link_to "Drafts", messages_path %>
          <%= nav_link_to "Cadence", edit_cadence_path %>
          <% if defined?(MissionControl::Jobs::Engine) %>
            <%= nav_link_to "Jobs", mission_control_jobs_path, data: { turbo: false } %>
          <% end %>
        </nav>
        <% if Clock.pinned? %>
          <span class="ml-auto rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-ink"
                title="The seed events end 2026-08-16, so the demo clock is pinned just after them.">
            Demo clock &middot; <%= Clock.now.utc.strftime("%b %-d, %Y %H:%M UTC") %>
          </span>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
      <div id="flash"><%= render "shared/flash" %></div>
      <%= yield %>
    </main>
  </body>
</html>
