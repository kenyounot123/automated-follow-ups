<% content_for :title, "Triage" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Follow-up triage</h1>
  <p class="mt-1 text-sm text-ink-soft">
    Ranked by how much is at stake and how warm the signal is. Drafts are written automatically; nothing is sent until you approve one.
  </p>
</div>

<section class="mb-8 overflow-hidden rounded-2xl border border-brand-100 bg-brand-50">
  <div class="flex flex-col gap-5 border-b border-brand-100 px-5 py-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-brand-800">Replay lab</p>
      <h2 class="mt-1 text-xl font-bold tracking-tight text-ink">Walk one real customer journey</h2>
      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-soft">
        Move the clock, let events arrive, then watch ingestion, triage, drafting and sending change the queue.
      </p>
    </div>
    <%= button_to "Reset demo", demo_reset_path,
          class: "shrink-0 rounded-lg border border-brand-200 bg-white px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-100" %>
  </div>

  <div class="grid gap-4 px-5 py-5 sm:grid-cols-3">
    <div>
      <p class="text-xs font-semibold text-brand-800">Simulated time</p>
      <p class="mt-1 font-semibold text-ink"><%= @demo.now.utc.strftime("%b %-d, %Y · %H:%M UTC") %></p>
    </div>
    <div>
      <p class="text-xs font-semibold text-brand-800">Event stream</p>
      <p class="mt-1 font-semibold text-ink"><%= @demo.ingested_count %> / <%= @demo.source_count %> events released</p>
    </div>
    <div>
      <p class="text-xs font-semibold text-brand-800">Next event</p>
      <p class="mt-1 font-semibold text-ink">
        <% if @demo.next_event %>
          <%= @demo.next_event.fetch("type").tr("_", " ") %>
          <span class="font-normal text-ink-soft">· <%= @demo.next_event.fetch("quote_id") %></span>
        <% else %>
          Stream complete
        <% end %>
      </p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 border-t border-brand-100 bg-white/60 px-5 py-4">
    <%= button_to "Ingest next event", demo_next_event_path,
          class: "rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-700" %>
    <%= button_to "Run cycle now", demo_cycle_path,
          class: "rounded-lg border border-brand-200 bg-white px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-100" %>
    <%= button_to "Advance 1 day", demo_advance_path(hours: 24),
          class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-ink-soft hover:bg-slate-50" %>
    <%= button_to "Advance 4 days", demo_advance_path(hours: 96),
          class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-ink-soft hover:bg-slate-50" %>
  </div>

  <% activity = @account.events.includes(:quote).chronological %>
  <% if activity.any? %>
    <div class="border-t border-brand-100 px-5 py-4">
      <p class="text-xs font-semibold text-brand-800">Activity timeline · oldest first</p>
      <ol id="activity-timeline" class="mt-2 max-h-64 divide-y divide-brand-100 overflow-y-auto rounded-lg border border-brand-100 bg-white/60 text-sm">
        <% activity.each do |event| %>
          <li class="flex items-center gap-3 px-3 py-2" data-event-id="<%= event.external_event_id %>">
            <time class="w-36 shrink-0 tabular-nums text-xs text-ink-soft" datetime="<%= event.occurred_at.iso8601 %>">
              <%= event.occurred_at.utc.strftime("%b %-d · %H:%M UTC") %>
            </time>
            <span class="text-ink"><%= event.event_type.tr("_", " ") %></span>
            <%= link_to event.quote.external_id, quote_path(event.quote), class: "font-medium text-brand-600 hover:underline" %>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
</section>

<section id="triage-candidates" class="mb-8">
  <div class="mb-3">
    <h2 class="text-lg font-bold tracking-tight">Triage candidates</h2>
    <p class="mt-1 text-sm text-ink-soft">Quotes that meet the Cadence rules and are waiting for drafting.</p>
  </div>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <%= render "queue_table", candidates: @candidates,
          empty_message: "No quotes currently meet the Cadence rules." %>
  </div>
</section>

<section id="drafts-ready" class="mb-8">
  <div class="mb-3 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold tracking-tight">Drafts ready for review</h2>
      <p class="mt-1 text-sm text-ink-soft">Messages created from triage candidates. Nothing is sent until you approve it.</p>
    </div>
    <% if @drafts.any? %>
      <%= link_to "Review drafts →", messages_path, class: "shrink-0 text-sm font-semibold text-brand-600 hover:underline" %>
    <% end %>
  </div>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <%= render "queue_table", candidates: @drafts,
          empty_message: "No drafts are waiting for review." %>
  </div>
</section>

<% if @triage.needs_reply.any? %>
  <section class="mt-8">
    <h2 class="text-lg font-bold tracking-tight">Needs a human reply</h2>
    <p class="mt-1 mb-3 text-sm text-ink-soft">
      These customers wrote back and nobody answered. A templated nudge is the wrong response, so they are not drafted.
    </p>
    <ul class="divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white">
      <% @triage.needs_reply.each do |quote| %>
        <li class="flex items-center gap-4 px-4 py-3 text-sm">
          <%= link_to quote.external_id, quote_path(quote), class: "font-medium font-semibold text-brand-600 hover:underline" %>
          <span><%= quote.customer.name %></span>
          <span class="tabular-nums text-ink-soft"><%= money(quote.amount_cents) %></span>
          <span class="ml-auto text-ink-soft">replied <%= when_ago(quote.last_customer_reply_at) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
