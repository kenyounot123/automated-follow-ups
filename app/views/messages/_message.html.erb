<article id="<%= dom_id(message) %>" class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex items-start gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <%= link_to message.quote.external_id, quote_path(message.quote), class: "font-medium font-semibold text-brand-600 hover:underline" %>
        <span class="font-medium"><%= message.customer.name %></span>
        <span class="tabular-nums text-ink-soft"><%= money(message.quote.amount_cents) %></span>
        <%= reason_chip(message.reason) %>
        <span class="text-xs text-ink-soft"><%= message.cadence_step.label %> &middot; <%= message.cadence_step.channel %></span>
      </div>
      <p class="mt-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 text-sm leading-relaxed text-ink">
        <%= message.body %>
      </p>
    </div>
    <% if message.draft? %>
      <div class="flex shrink-0 gap-2">
        <%= button_to "Approve", message_approval_path(message),
              class: "rounded-lg bg-accent-500 px-4 py-2 text-sm font-bold text-ink hover:bg-accent-400" %>
        <%= button_to "Deny", message_approval_path(message), method: :delete,
              class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-ink-soft hover:bg-slate-50" %>
      </div>
    <% else %>
      <%= status_chip(message.status) %>
    <% end %>
  </div>
</article>
